GEMINI_API_KEY=paste_your_actual_key_here
GEMINI_MODEL=gemini-3.8-flash
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
FRONTEND_URL=http://localhost:3000
# Exact public HTTPS webhook URL, required behind a tunnel/reverse proxy:
TWILIO_WEBHOOK_URL=

# Mobile + portal share these settings. HTTPS deployment is the default.
CARELINK_DATABASE_URL=sqlite:///./carelink.db
CARELINK_UPLOAD_DIR=uploads
CARELINK_COOKIE_SECURE=1
CARELINK_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Optional integration stays off until sender consent and deployment review.
CARELINK_ENABLE_WHATSAPP=0
# RAG optional providers (server-side only)
CARELINK_RAG_MODEL=gemini-3.5-flash-lite
CARELINK_EMBEDDING_MODEL=gemini-embedding-001
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
