  "standard_anc_visits": [
    {
      "id": "ANC-T1-FIRST",
      "title": "First ANC Visit — Registration & Baseline",
      "trimester": 1,
      "visit_type": "First Visit / Registration",
      "gestational_week_range": "6-12 weeks",
      "description": "Initial pregnancy registration and baseline assessment. Most common first visit in Indian public health setting.",
      "standard_fields": {
        "chief_complaint": "Missed periods / Positive UPT",
        "lmp_date": "<to be filled>",
        "edd_calculation": "Naegele's Rule: LMP + 9 months + 7 days",
        "gravida_para": "<to be filled>",
        "obstetric_history": {
          "previous_pregnancies": "<number>",
          "previous_deliveries": "<number>",
          "abortions": "<number>",
          "living_children": "<number>",
          "previous_complications": "None / <specify>"
        },
        "vitals": {
          "blood_pressure": "<mmHg>",
          "weight": "<kg>",
          "height": "<cm>",
          "bmi": "<calculated>",
          "pulse": "<bpm>",
          "temperature": "<°F>"
        },
        "general_examination": {
          "pallor": "Absent / Present",
          "edema": "Absent / Present",
          "thyroid": "Normal / Enlarged",
          "breast_examination": "Normal"
        },
        "investigations_ordered": [
          "CBC (Complete Blood Count)",
          "Blood Group & Rh Typing",
          "Random Blood Sugar",
          "Urine Routine & Microscopy",
          "HIV / VDRL / HBsAg",
          "TSH (Thyroid)",
          "First Trimester Ultrasound (Dating Scan)"
        ],
        "medications_prescribed": [
          {"drug": "Folic Acid", "dose": "5mg", "frequency": "Once daily", "duration": "Till 12 weeks"},
          {"drug": "Iron + Folic Acid (IFA)", "dose": "1 tablet", "frequency": "Once daily", "duration": "Throughout pregnancy"},
          {"drug": "Calcium", "dose": "500mg", "frequency": "Twice daily", "duration": "Throughout pregnancy"}
        ],
        "advice_given": [
          "Balanced diet with green leafy vegetables",
          "Avoid raw/undercooked food",
          "Continue folic acid supplementation",
          "Avoid smoking, alcohol, tobacco",
          "Next visit in 4 weeks",
          "Danger signs to report immediately"
        ],
        "next_visit": "4 weeks from today",
        "risk_category": "Low Risk"
      },
      "confidence_note": "Applies to ~90% of first ANC registrations"
    },
    {
      "id": "ANC-T1-FOLLOWUP",
