          "2_hour": "<mg/dL> (Normal: <153)",
          "diagnosis": "Normal / Gestational Diabetes Mellitus (GDM)"
        },
        "action_if_normal": "Continue routine ANC, next visit in 4 weeks",
        "action_if_gdm": "Refer to physician, dietary counselling, blood sugar monitoring",
        "action_if_anomaly": "Refer to higher center / MFM specialist",
        "risk_category": "Low Risk / High Risk (if GDM or anomaly detected)"
      },
      "confidence_note": "80% of anomaly scans are normal — auto-fill accordingly"
    },
    {
      "id": "ANC-T3-ROUTINE",
      "title": "Third Trimester Routine ANC Visit",
      "trimester": 3,
      "visit_type": "Routine",
      "gestational_week_range": "28-36 weeks",
