  "common_symptoms_diagnosis_map": [
    {
      "id": "SYM-001",
      "symptom": "Nausea and Vomiting",
      "trimester": 1,
      "likely_diagnosis": "Morning Sickness (Nausea Gravidarum)",
      "severity_scale": {
        "mild": "Occasional vomiting, tolerating food, no dehydration",
        "moderate": "Frequent vomiting, mild dehydration, weight loss <5%",
        "severe": "Hyperemesis Gravidarum — persistent vomiting, ketonuria, weight loss >5%, needs IV fluids"
      },
      "standard_treatment": {
        "mild": [{"drug": "Doxylamine + Pyridoxine", "dose": "10mg+10mg", "frequency": "At bedtime"}],
        "moderate": [{"drug": "Ondansetron", "dose": "4mg", "frequency": "SOS", "note": "After 1st trimester only"}],
        "severe": "REFER TO DOCTOR — needs IV fluids and admission"
      },
      "flag_for_doctor": false,
      "flag_conditions": "Flag if weight loss >5% or ketonuria present"
    },
    {
      "id": "SYM-002",
      "symptom": "Bleeding / Spotting PV",
      "trimester": 1,
      "likely_diagnosis": "Threatened Abortion / Implantation Bleeding",
      "severity_scale": {
        "mild": "Scanty spotting, no pain, closed cervix",
        "moderate": "Mild bleeding with cramping",
        "severe": "Heavy bleeding with clots and pain"
      },
      "standard_treatment": {
        "mild": [{"drug": "Progesterone support", "dose": "200mg", "frequency": "Twice daily", "route": "Vaginal/Oral"}],
        "moderate": "REFER TO DOCTOR",
        "severe": "EMERGENCY — REFER IMMEDIATELY"
      },
      "flag_for_doctor": true,
      "flag_conditions": "Always flag — any PV bleeding needs doctor confirmation"
    },
    {
      "id": "SYM-003",
      "symptom": "Headache + Swelling of Feet + High BP",
      "trimester": 3,
      "likely_diagnosis": "Preeclampsia",
      "severity_scale": {
        "mild": "BP 140/90-149/99, mild edema, no proteinuria",
        "moderate": "BP 150/100-159/109, proteinuria 1+",
        "severe": "BP ≥160/110, proteinuria 2+, headache, visual disturbance, epigastric pain"
      },
      "standard_treatment": {
        "mild": "Bed rest, monitor BP twice daily, low salt diet",
        "moderate": [{"drug": "Labetalol", "dose": "100mg", "frequency": "Twice daily"}, {"drug": "Methyldopa", "dose": "250mg", "frequency": "Thrice daily"}],
        "severe": "EMERGENCY — REFER IMMEDIATELY — MgSO4 protocol"
      },
      "flag_for_doctor": true,
      "flag_conditions": "Always flag — preeclampsia needs physician management"
    },
    {
      "id": "SYM-004",
      "symptom": "Reduced Fetal Movements",
      "trimester": 3,
      "likely_diagnosis": "Fetal Distress (Rule Out)",
      "severity_scale": {
        "mild": "Less than 10 movements in 2 hours but NST reactive",
        "moderate": "Significantly reduced movements, NST equivocal",
        "severe": "No fetal movements felt for >12 hours"
      },
      "standard_treatment": {
        "mild": "Reassure, advise kick count chart, repeat NST in 24hrs",
        "moderate": "REFER TO DOCTOR — biophysical profile needed",
        "severe": "EMERGENCY — immediate NST/USG, possible emergency delivery"
      },
      "flag_for_doctor": true,
      "flag_conditions": "Always flag if <10 movements in 2 hours"
    },
    {
      "id": "SYM-005",
      "symptom": "Leaking / Watery Discharge PV",
      "trimester": 3,
      "likely_diagnosis": "Premature Rupture of Membranes (PROM)",
      "severity_scale": {
        "mild": "Scanty watery discharge, not sure if urine or liquor",
        "moderate": "Clear watery gush, litmus positive",
        "severe": "Continuous leak with fever or foul smell"
      },
      "standard_treatment": {
        "mild": "Litmus test / Fern test — confirm leak. Pad test for 1 hour.",
        "moderate": "ADMIT — steroids if preterm, antibiotics, monitor",
        "severe": "EMERGENCY — risk of chorioamnionitis, immediate delivery"
      },
      "flag_for_doctor": true,
      "flag_conditions": "Always flag — PROM needs doctor management"
    },
    {
      "id": "SYM-006",
      "symptom": "Burning Urination / Frequent Urination",
      "trimester": "Any",
      "likely_diagnosis": "Urinary Tract Infection (UTI)",
      "severity_scale": {
        "mild": "Dysuria only, no fever",
        "moderate": "Dysuria + frequency + mild fever",
        "severe": "High fever, loin pain — suspect Pyelonephritis"
      },
      "standard_treatment": {
        "mild": [{"drug": "Nitrofurantoin", "dose": "100mg", "frequency": "Twice daily", "duration": "7 days"}],
        "moderate": [{"drug": "Cephalexin", "dose": "500mg", "frequency": "Thrice daily", "duration": "7 days"}],
        "severe": "REFER TO DOCTOR — IV antibiotics needed"
      },
      "flag_for_doctor": false,
      "flag_conditions": "Flag if fever >101°F or loin pain"
    },
    {
      "id": "SYM-007",
      "symptom": "Itching All Over Body",
      "trimester": 3,
      "likely_diagnosis": "Intrahepatic Cholestasis of Pregnancy (ICP)",
      "severity_scale": {
        "mild": "Generalized itching, no jaundice, normal LFT",
        "moderate": "Severe itching especially palms and soles, raised bile acids",
        "severe": "Jaundice + itching + deranged LFT"
      },
      "standard_treatment": {
        "mild": "Antihistamines (Cetirizine 10mg), check LFT and bile acids",
        "moderate": [{"drug": "Ursodeoxycholic Acid (UDCA)", "dose": "300mg", "frequency": "Twice daily"}],
        "severe": "REFER TO DOCTOR — early delivery may be needed"
      },
      "flag_for_doctor": true,
      "flag_conditions": "Flag if palms/soles itching or bile acids elevated"
    },
    {
      "id": "SYM-008",
      "symptom": "White Discharge PV",
      "trimester": "Any",
      "likely_diagnosis": "Vaginal Candidiasis / Leucorrhoea",
      "severity_scale": {
        "mild": "White, non-foul smelling discharge",
        "moderate": "Curdy white discharge with itching",
        "severe": "Foul-smelling greenish discharge — suspect BV/Trichomoniasis"
      },
      "standard_treatment": {
        "mild": "Reassure — physiological leucorrhoea is common in pregnancy",
        "moderate": [{"drug": "Clotrimazole vaginal pessary", "dose": "200mg", "frequency": "Once at bedtime", "duration": "3 nights"}],
        "severe": "REFER TO DOCTOR — culture and sensitivity needed"
      },
      "flag_for_doctor": false,
      "flag_conditions": "Flag if foul smell or greenish discharge"
    }
  ],

  "normal_vitals_reference": {
    "blood_pressure": {
      "normal": "90/60 - 139/89 mmHg",
      "alert_high": "≥140/90 mmHg — suspect PIH/Preeclampsia",
      "alert_low": "<90/60 mmHg — suspect dehydration or shock",
      "emergency": "≥160/110 mmHg — severe preeclampsia, immediate referral"
    },
    "hemoglobin": {
      "normal": "≥11 g/dL",
      "mild_anemia": "10-10.9 g/dL — oral iron therapy",
      "moderate_anemia": "7-9.9 g/dL — double dose iron, consider IV iron",
      "severe_anemia": "<7 g/dL — REFER, may need blood transfusion"
    },
    "blood_sugar": {
      "fasting_normal": "<92 mg/dL",
      "random_normal": "<140 mg/dL",
      "ogtt_1hr_normal": "<180 mg/dL",
      "ogtt_2hr_normal": "<153 mg/dL",
      "gdm_diagnosis": "Any ONE value abnormal on OGTT = GDM"
    },
    "tsh_thyroid": {
      "trimester_1": "0.1 - 2.5 mIU/L",
      "trimester_2": "0.2 - 3.0 mIU/L",
      "trimester_3": "0.3 - 3.5 mIU/L",
      "subclinical_hypo": "TSH elevated but T4 normal — may need levothyroxine",
      "overt_hypo": "TSH >10 or symptomatic — REFER to physician"
    },
    "fetal_heart_rate": {
      "normal": "120-160 bpm",
      "tachycardia": ">160 bpm — may indicate fetal distress or maternal fever",
      "bradycardia": "<120 bpm — URGENT, possible fetal distress"
    },
    "weight_gain_expected": {
      "underweight_bmi_lt_18_5": "12.5-18 kg total",
      "normal_bmi_18_5_24_9": "11.5-16 kg total",
      "overweight_bmi_25_29_9": "7-11.5 kg total",
      "obese_bmi_gte_30": "5-9 kg total",
      "monthly_t2_t3": "1.5-2 kg per month"
    },
    "fundal_height": {
      "rule": "Fundal height in cm ≈ Gestational age in weeks (±2 cm)",
      "small_for_dates": ">2 cm less than expected — suspect IUGR, refer for growth scan",
      "large_for_dates": ">2 cm more than expected — suspect macrosomia/polyhydramnios/twins"
    }
  },

