    {
      "id": "ANC-T2-ROUTINE",
      "title": "Second Trimester Routine ANC Visit",
      "trimester": 2,
      "visit_type": "Routine",
      "gestational_week_range": "14-26 weeks",
      "description": "Most common ANC visit type. Routine check, anomaly scan, TT vaccine, OGTT screening.",
      "standard_fields": {
        "chief_complaint": "Routine ANC check-up",
        "vitals": {
          "blood_pressure": "<mmHg> (Normal: <140/90)",
          "weight": "<kg>",
          "weight_gain_since_last": "<kg> (Expected: 0.5-1 kg/month in T2)",
          "pulse": "<bpm>",
          "fundal_height": "<cm> (Should match gestational weeks ±2)"
        },
        "abdominal_examination": {
          "uterus_size": "Corresponds to dates / Small / Large",
          "fetal_heart_sound": "Present / <bpm> (Normal: 120-160)",
          "fetal_movements": "Present / Not yet felt"
        },
        "investigations_ordered": [
          "OGTT (Oral Glucose Tolerance Test) at 24-28 weeks",
          "Anomaly Scan (Level 2 Ultrasound) at 18-20 weeks",
          "Repeat Hemoglobin if low at first visit",
          "Urine for protein/sugar"
        ],
        "vaccinations": [
          {"vaccine": "Td (Tetanus-Diphtheria)", "dose": "Td-1 or Td-2 or Td Booster", "route": "IM", "note": "As per immunization schedule"}
        ],
        "medications_prescribed": [
          {"drug": "IFA tablet", "dose": "1 tablet", "frequency": "Once daily", "duration": "Continue"},
          {"drug": "Calcium", "dose": "500mg", "frequency": "Twice daily", "duration": "Continue"}
        ],
        "advice_given": [
          "Increased protein and iron-rich diet",
          "Monitor fetal movements daily after 20 weeks",
          "Report reduced fetal movements immediately",
          "Sleep on left lateral position",
          "Gentle exercise / walking daily"
        ],
        "next_visit": "4 weeks (monthly till 28 weeks)",
        "risk_category": "Low Risk"
      },
      "confidence_note": "Covers 90% of second trimester routine visits"
    },
    {
      "id": "ANC-T2-ANOMALY-REVIEW",
      "title": "Second Trimester — Anomaly Scan Review",
      "trimester": 2,
      "visit_type": "Investigation Review",
      "gestational_week_range": "20-22 weeks",
      "description": "Review of Level 2 anomaly scan and OGTT results.",
      "standard_fields": {
        "chief_complaint": "Scan review / Routine",
        "anomaly_scan_findings": {
          "fetal_anatomy": "Normal / Abnormal — <specify>",
          "placenta_position": "Anterior / Posterior / Fundal / Low-lying",
