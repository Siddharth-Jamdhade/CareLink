          "blood_pressure": "<mmHg> (Alert if ≥140/90)",
          "weight": "<kg>",
          "weight_gain_total": "<kg> (Expected total: 10-12 kg)",
          "pulse": "<bpm>",
          "fundal_height": "<cm>"
        },
        "abdominal_examination": {
          "presentation": "Cephalic / Breech / Transverse",
          "fetal_heart_rate": "<bpm> (Normal: 120-160)",
