    }
  },

  "common_complications_templates": [
    {
      "id": "COMP-001",
      "condition": "Gestational Diabetes Mellitus (GDM)",
      "frequency": "~10-15% of Indian pregnancies",
      "diagnosis_criteria": "OGTT (75g): Fasting ≥92, 1hr ≥180, 2hr ≥153 — any ONE abnormal",
      "standard_management": {
        "diet": "Medical Nutrition Therapy — small frequent meals, low GI, no sugar",
        "monitoring": "4-point blood sugar profile (Fasting + 2hr post each meal)",
        "exercise": "30 min daily walking after meals",
        "medication_if_needed": [
          {"drug": "Metformin", "dose": "500mg", "frequency": "Twice daily", "note": "If diet fails after 2 weeks"},
          {"drug": "Insulin", "note": "If metformin insufficient — REFER TO DOCTOR"}
        ],
        "targets": {
          "fasting": "<95 mg/dL",
          "2hr_post_meal": "<120 mg/dL"
        }
      },
      "flag_for_doctor": true,
      "risk_category": "High Risk"
    },
    {
      "id": "COMP-002",
      "condition": "Anaemia in Pregnancy",
      "frequency": "~50% of Indian pregnant women",
      "diagnosis_criteria": "Hb <11 g/dL",
      "standard_management": {
        "mild_10_10_9": [
          {"drug": "IFA (Iron Folic Acid)", "dose": "1 tablet", "frequency": "Once daily"},
          {"note": "Dietary advice: jaggery, dates, green leafy vegetables, vitamin C with iron"}
        ],
        "moderate_7_9_9": [
          {"drug": "IFA", "dose": "2 tablets daily (morning + evening)"},
          {"drug": "IV Iron Sucrose", "dose": "200mg", "frequency": "Alternate days x 5 doses", "note": "If oral not tolerated"},
          {"note": "Deworming: Albendazole 400mg single dose (after 1st trimester)"}
        ],
        "severe_lt_7": "REFER — blood transfusion may be needed"
      },
      "flag_for_doctor": false,
      "flag_conditions": "Flag if Hb <7 or not responding to oral iron in 4 weeks"
    },
    {
      "id": "COMP-003",
      "condition": "Hypothyroidism in Pregnancy",
      "frequency": "~10-12% in India",
      "diagnosis_criteria": "TSH above trimester-specific range",
