          {"drug": "IFA tablet", "dose": "1 tablet", "frequency": "Once daily", "duration": "Continue"},
          {"drug": "Calcium", "dose": "500mg", "frequency": "Twice daily", "duration": "Continue"}
        ],
        "next_visit": "2 weeks (fortnightly from 28-36 weeks)",
        "risk_category": "Low Risk"
      },
      "confidence_note": "Standard for 85% of third trimester visits"
    },
