      "full_name": "Janani Shishu Suraksha Karyakram",
      "entitlements": [
        "Free delivery (normal and C-section) at public facilities",
        "Free drugs and consumables",
        "Free diagnostics",
        "Free diet during hospital stay",
        "Free blood (up to 3 units)",
        "Free transport (home to facility and back)",
        "No out-of-pocket expense for the mother"
      ],
      "eligibility": "All pregnant women delivering in government health facilities"
    },
    "pmsma": {
      "full_name": "Pradhan Mantri Surakshit Matritva Abhiyan",
      "description": "Free ANC check-up on the 9th of every month by OBGYN specialists at government facilities",
      "services": [
        "Free comprehensive ANC check-up",
        "Ultrasound if needed",
        "Specialist consultation",
        "High risk identification and referral"
      ]
    },
    "pmmvy": {
      "full_name": "Pradhan Mantri Matru Vandana Yojana",
      "description": "Cash incentive of ₹5,000 in 3 installments for first living child",
      "installments": [
        {"amount": 1000, "condition": "Early registration (within 150 days of LMP)"},
        {"amount": 2000, "condition": "At least one ANC at 6 months"},
        {"amount": 2000, "condition": "Child birth registration + first cycle of vaccination"}
      ]
    },
